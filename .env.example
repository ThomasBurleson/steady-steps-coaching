# Copy to `.env` for local dev, and set the same vars in Netlify
# (Site settings → Environment variables) for production.

# ── Frontend (Vite — must be prefixed VITE_) ──
# Your Calendly scheduling link, e.g. https://calendly.com/your-name/clarity-session
VITE_CALENDLY_URL=

# ── Backend: Calendly webhook → Twilio SMS (Netlify Function) ──
# Returned when you create the webhook subscription (see README / plan step B4).
CALENDLY_WEBHOOK_SIGNING_KEY=

# Twilio credentials and numbers (E.164 format, e.g. +15555550123)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
COACH_PHONE_NUMBER=

# Optional: IANA timezone for formatting the booking time in the SMS
# (defaults to the invitee's timezone from Calendly). e.g. America/New_York
COACH_TIMEZONE=
