# Local dev overrides. Gitignored — set the same vars in Netlify
# (Site settings → Environment variables) for production.

# ── Frontend (Vite — must be prefixed VITE_) ──
# Your Calendly scheduling link, e.g. https://calendly.com/your-name/clarity-session
# REQUIRED for the scheduling popup to render at all (CalendlyProvider.tsx gates
# <PopupModal> on this being non-empty).
VITE_CALENDLY_URL=https://calendly.com/chelsea-steadysteps/30min

# ── Backend: Calendly webhook → Twilio SMS (Netlify Function) ──
# Only exercised under `netlify dev` (port 8888), not `npm run dev`.
# Returned when you create the webhook subscription.
CALENDLY_WEBHOOK_SIGNING_KEY=

# Twilio credentials and numbers (E.164 format, e.g. +15555550123)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
COACH_PHONE_NUMBER=

# Optional: IANA timezone for formatting the booking time in the SMS
# (defaults to the invitee's timezone from Calendly). e.g. America/New_York
COACH_TIMEZONE=America/NewYork

# ── Backend: blog Likes/Comments (Netlify Blobs + moderation) ──
# See docs/blog-reactions.md. Reuses the TWILIO_* and COACH_PHONE_NUMBER vars above.
# Secret embedded in the comment-approval link — set to a long random string.
ADMIN_TOKEN=
# Optional: origin used to build the approve link (falls back to the request origin).
SITE_URL=
