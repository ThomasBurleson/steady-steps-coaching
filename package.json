{
  "name": "@mindspace/steady-steps",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\"",
    "webhook:setup": "node scripts/setup-calendly-webhook.mjs",
    "blog:fetch": "node scripts/fetch-gdoc.mjs",
    "blog:images": "node scripts/extract-docx-images.mjs",
    "blog:convert": "node scripts/md-to-blocks.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@netlify/blobs": "^10.7.10",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react-calendly": "^4.4.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "7.55.0",
    "react-markdown": "^10.1.0",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "^26.0.0",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.8.4",
    "tailwindcss": "4.1.12",
    "typescript": "~5.7",
    "vite": "^6.4.3"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
